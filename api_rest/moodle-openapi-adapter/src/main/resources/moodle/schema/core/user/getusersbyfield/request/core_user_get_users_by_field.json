{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "GetUsersByFieldRequest",
  "description": "Retrieve users' information for a specified unique field - If you want to do a user search, use core_user_get_users() or core_user_search_identity().\n",
  "properties": {
    "wsfunction": {
      "type": "string",
      "default": "core_user_get_users_by_field"
    },
    "field": {
      "description": "the search field can be 'id' or 'idnumber' or 'username' or 'email'",
      "type": "string",
      "enum": [
        "id",
        "idnumber",
        "username",
        "email"
      ],
      "javaEnums": [
        {
          "name": "ID"
        },
        {
          "name": "ID_NUMBER"
        },
        {
          "name": "USERNAME"
        },
        {
          "name": "EMAIL"
        }
      ]
    },
    "values": {
      "type": "array",
      "description": "the value to match",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "field",
    "values"
  ]
}
