{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GetForumDiscussionsRequest",
  "description": "Returns a list of forum instances in a provided set of courses, if no courses are provided then all the forum instances the user has access to will be returned.\n",
  "type": "object",
  "properties": {
    "wsfunction": {
      "type": "string",
      "default": "mod_forum_get_forum_discussions"
    },
    "forumid": {
      "type": "integer",
      "description": "Forum Id"
    },
    "sortorder": {
      "type": "integer",
      "description": "sort by this element: numreplies, , created or timemodified",
      "enum": [
        1,
        2,
        3,
        4,
        5,
        6
      ],
      "javaEnums": [
        {
          "name": "LASTPOST_DESC"
        },
        {
          "name": "LASTPOST_ASC"
        },
        {
          "name": "CREATED_DESC"
        },
        {
          "name": "CREATED_ASC"
        },
        {
          "name": "REPLIES_DESC"
        },
        {
          "name": "REPLIES_ASC"
        }
      ]
    },
    "page": {
      "type": "integer",
      "description": "current page"
    },
    "perpage": {
      "type": "integer",
      "description": "items per page"
    },
    "groupid": {
      "type": "integer",
      "description": "Group id"
    }
  },
  "required": [
    "forumid"
  ]
}
