{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "GetActivitiesCompletionStatusRequest",
  "description": "Return the activities completion status for a user in a course.",
  "properties": {
    "wsfunction": {
      "type": "string",
      "default": "core_completion_get_activities_completion_status"
    },
    "courseid": {
      "type": "integer",
      "description": "Course ID"
    },
    "userid": {
      "type": "integer",
      "description": "User ID"
    }
  },
  "required": [
    "courseid",
    "userid"
  ]
}
