{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GetSiteInfoResponse",
  "description": "Return some site info / user info / list web service functions",
  "type": "object",
  "properties": {
    "sitename": {
      "type": "string",
      "description": "Site name"
    },
    "username": {
      "type": "string",
      "description": "Username"
    },
    "firstname": {
      "type": "string",
      "description": "First name"
    },
    "lastname": {
      "type": "string",
      "description": "Last name"
    },
    "fullname": {
      "type": "string",
      "description": "User full name"
    },
    "lang": {
      "type": "string",
      "description": "Current language"
    },
    "userid": {
      "type": "integer",
      "description": "User id"
    },
    "siteurl": {
      "type": "string",
      "format": "uri",
      "description": "Site URL"
    },
    "userpictureurl": {
      "type": "string",
      "format": "uri",
      "description": "The user profile picture URL (public URL; use webservice/pluginfile.php with token for private access)"
    },
    "functions": {
      "type": "array",
      "description": "Functions that are available",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Function name"
          },
          "version": {
            "type": "string",
            "description": "Version number of the component"
          }
        },
        "required": [
          "name",
          "version"
        ]
      }
    },
    "downloadfiles": {
      "type": "integer",
      "description": "1 if users are allowed to download files, 0 if not",
      "nullable": true
    },
    "uploadfiles": {
      "type": "integer",
      "description": "1 if users are allowed to upload files, 0 if not",
      "nullable": true
    },
    "release": {
      "type": "string",
      "description": "Moodle release number",
      "nullable": true
    },
    "version": {
      "type": "string",
      "description": "Moodle version number",
      "nullable": true
    },
    "mobilecssurl": {
      "type": "string",
      "description": "Mobile custom CSS theme",
      "nullable": true
    },
    "advancedfeatures": {
      "type": "array",
      "description": "Advanced features availability",
      "nullable": true,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Feature name"
          },
          "value": {
            "type": "integer",
            "description": "Feature value. Usually 1 means enabled."
          }
        },
        "required": [
          "name",
          "value"
        ]
      }
    },
    "usercanmanageownfiles": {
      "type": "boolean",
      "description": "True if the user can manage his own files",
      "nullable": true
    },
    "userquota": {
      "type": "integer",
      "description": "User quota (bytes). 0 means ignore quota",
      "nullable": true
    },
    "usermaxuploadfilesize": {
      "type": "integer",
      "description": "User max upload file size (bytes). -1 means ignore limit",
      "nullable": true
    },
    "userhomepage": {
      "type": "integer",
      "description": "Default home page: 0 for site home, 1 for dashboard",
      "nullable": true
    },
    "userhomepageurl": {
      "type": "string",
      "description": "URL of default home page when userhomepage is 4 (HOMEPAGE_URL)",
      "nullable": true
    },
    "userprivateaccesskey": {
      "type": "string",
      "description": "Private user access key for fetching files",
      "nullable": true
    },
    "siteid": {
      "type": "integer",
      "description": "Site course ID",
      "nullable": true
    },
    "sitecalendartype": {
      "type": "string",
      "description": "Calendar type set in the site",
      "nullable": true
    },
    "usercalendartype": {
      "type": "string",
      "description": "Calendar type used by the user",
      "nullable": true
    },
    "userissiteadmin": {
      "type": "boolean",
      "description": "Whether the user is a site admin",
      "nullable": true
    },
    "theme": {
      "type": "string",
      "description": "Current theme for the user",
      "nullable": true
    },
    "limitconcurrentlogins": {
      "type": "integer",
      "description": "Number of concurrent sessions allowed",
      "nullable": true
    },
    "usersessionscount": {
      "type": "integer",
      "description": "Number of active sessions for current user",
      "nullable": true
    },
    "policyagreed": {
      "type": "integer",
      "description": "Whether user accepted all policies",
      "nullable": true
    }
  },
  "required": [
    "sitename",
    "username",
    "firstname",
    "lastname",
    "fullname",
    "lang",
    "userid",
    "siteurl",
    "userpictureurl",
    "functions"
  ]
}
