{
  "description": "Test case for login adapter",
  "request": {
    "method": "GET",
    "path": "/site/info",
    "headers": [
      {
        "name": "X-MOODLE-TOKEN",
        "value": "{{TOKEN}}"
      },
      {
        "name": "X-MOODLE-HOST",
        "value": "{{HOST}}"
      }
    ]
  },
  "expectedResponse": {
    "status": 401,
    "body": {
      "code": "UNAUTHORIZED",
      "message": "Invalid token - token not found",
      "timestamp": "${json-unit.any-string}",
      "traceId": "${json-unit.any-string}",
      "errors": [
        {
          "field": "exception",
          "message": "401 UNAUTHORIZED \"Invalid token - token not found\""
        }
      ]
    }
  },
  "moodleApiMocks": [
    {
      "request": {
        "formData": [
          {
            "name": "wsfunction",
            "value": "tool_mobile_get_public_config"
          }
        ]
      },
      "response": {
        "body": {
          "exception": "core\\exception\\moodle_exception",
          "errorcode": "invalidtoken",
          "message": "Invalid token - token not found"
        }
      }
    },
    {
      "request": {
        "formData": [
          {
            "name": "wsfunction",
            "value": "core_webservice_get_site_info"
          }
        ]
      },
      "response": {
        "body": {
          "exception": "core\\exception\\moodle_exception",
          "errorcode": "invalidtoken",
          "message": "Invalid token - token not found"
        }
      }
    }
  ]
}
